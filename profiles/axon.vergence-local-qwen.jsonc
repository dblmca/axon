{
  "$schema": "https://opencode.ai/config.json",

  // Qwen3.6-35B on Vector (local, free) driving LOCAL vergence MCP tools.
  // Tests how much the knowledge layers compensate for a weaker model.
  "enabled_providers": ["vector-qwen"],
  "model": "vector-qwen/Qwen3.6-35B-A3B-abliterated-Q4_K_M.gguf",
  "small_model": "vector-qwen/Qwen3.6-35B-A3B-abliterated-Q4_K_M.gguf",

  "provider": {
    "vector-qwen": {
      "name": "Vector Qwen3.6",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.1.153:8081/v1",
        "timeout": 1200000
      },
      "models": {
        "Qwen3.6-35B-A3B-abliterated-Q4_K_M.gguf": {
          "name": "Qwen3.6-35B-A3B-abliterated-Q4_K_M",
          "family": "qwen",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          },
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },

  "tools": {
    "task": false,
    "skill": false,
    "todowrite": false,
    "webfetch": false,
    "websearch": false,
    "codesearch": false
  },

  "permission": {
    "engram_*": "allow",
    "vergence_*": "allow",
    "jcodemunch_*": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow"
  },

  "mcp": {
    "engram": {
      "type": "local",
      "command": ["node", "{env:AXON_ENGRAM_MCP_SERVER}"],
      "environment": {
        "ENGRAM_API_KEY": "{env:ENGRAM_API_KEY}",
        "ENGRAM_WORKER_URL": "{env:ENGRAM_WORKER_URL}",
        "ENGRAM_AGENT_RUNTIME": "axon"
      },
      "enabled": false,
      "timeout": 10000
    },
    "vergence": {
      "type": "local",
      "command": ["/home/mmca/envs/vergence/bin/python", "/home/mmca/vergence/vergence-mcp/server_v2.py"],
      "environment": {
        "VERGENCE_VETERAN_MODE": "inject"
      },
      "enabled": true,
      "timeout": 1200000
    },
    "jcodemunch": {
      "type": "local",
      "command": ["/home/mmca/envs/jcodemunch/bin/jcodemunch-mcp", "serve"],
      "enabled": true,
      "timeout": 10000
    }
  }
}
