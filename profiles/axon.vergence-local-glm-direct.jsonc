{
  "$schema": "https://opencode.ai/config.json",

  // GLM 5.2 via Z.ai Coding Plan ($18/mo flat) driving LOCAL vergence MCP tools.
  // CRITICAL: use api.z.ai/api/coding/paas/v4 — NOT api/paas/v4 (per-token charges).
  "enabled_providers": ["zai"],
  "model": "zai/glm-5.2",
  "small_model": "zai/glm-5.2",

  "provider": {
    "zai": {
      "name": "Z.ai Coding",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "apiKey": "{env:Z_AI_API_KEY}",
        "timeout": 600000
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2",
          "family": "glm",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 16384
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },

  "tools": {
    "task": false,
    "skill": false,
    "todowrite": false,
    "webfetch": false,
    "websearch": false,
    "codesearch": false
  },

  "permission": {
    "engram_*": "allow",
    "vergence_*": "allow",
    "jcodemunch_*": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow"
  },

  "mcp": {
    "engram": {
      "type": "local",
      "command": ["node", "{env:AXON_ENGRAM_MCP_SERVER}"],
      "environment": {
        "ENGRAM_API_KEY": "{env:ENGRAM_API_KEY}",
        "ENGRAM_WORKER_URL": "{env:ENGRAM_WORKER_URL}",
        "ENGRAM_AGENT_RUNTIME": "axon"
      },
      "enabled": false,
      "timeout": 10000
    },
    "vergence": {
      "type": "local",
      "command": ["/home/mmca/envs/vergence/bin/python", "/home/mmca/vergence/vergence-mcp/server_v2.py"],
      "enabled": true,
      "timeout": 1200000
    },
    "jcodemunch": {
      "type": "local",
      "command": ["/home/mmca/envs/jcodemunch/bin/jcodemunch-mcp", "serve"],
      "enabled": true,
      "timeout": 10000
    }
  }
}
