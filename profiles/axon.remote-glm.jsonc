{
  "$schema": "https://opencode.ai/config.json",

  // GLM 5.2 via OpenRouter — remote variant.
  // MCP connects to localhost:8000 (no CF tunnel overhead).
  "enabled_providers": ["openrouter"],
  "model": "openrouter/z-ai/glm-5.2",
  "small_model": "openrouter/z-ai/glm-5.2",

  "provider": {
    "openrouter": {
      "name": "OpenRouter",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "timeout": 600000
      },
      "models": {
        "z-ai/glm-5.2": {
          "name": "GLM 5.2",
          "family": "glm",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },

  "tools": {
    "task": false,
    "skill": false,
    "todowrite": false,
    "webfetch": false,
    "websearch": false,
    "codesearch": false
  },

  "permission": {
    "vergence-p_*": "allow"
  },

  "mcp": {
    "vergence-p": {
      "type": "remote",
      "url": "http://127.0.0.1:8000/mcp/",
      "enabled": true,
      "timeout": 600000
    }
  }
}
