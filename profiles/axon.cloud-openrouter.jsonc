{
  "$schema": "https://opencode.ai/config.json",

  // Cloud provider via OpenRouter. For when the local GPU is busy.
  // Requires OPENROUTER_API_KEY. Still connects to local Engram.
  "enabled_providers": ["openrouter"],
  "model": "openrouter/deepseek/deepseek-chat-v3-0324",
  "small_model": "openrouter/deepseek/deepseek-chat-v3-0324",

  "provider": {
    "openrouter": {
      "name": "OpenRouter",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "timeout": 120000
      },
      "models": {
        "deepseek/deepseek-chat-v3-0324": {
          "name": "DeepSeek Chat V3 (0324)",
          "family": "deepseek",
          "attachment": true,
          "reasoning": false,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },

  "tools": {
    "task": false,
    "skill": false,
    "todowrite": false,
    "webfetch": false,
    "websearch": false,
    "codesearch": false
  },

  "permission": {
    "agentic-mcp_*": "deny",

    "engram_*": "ask",
    "engram_status": "allow",
    "engram_search": "allow",
    "engram_recall": "allow",
    "engram_context": "allow",
    "engram_decisions": "allow",
    "engram_note": "allow",
    "engram_working_memory": "allow",
    "engram_inbox": "allow",
    "engram_ack": "allow",
    "engram_send": "allow",
    "engram_handoff": "allow",
    "engram_agents": "allow",
    "engram_experts": "allow",
    "engram_channel": "allow",
    "engram_task": "allow",
    "engram_context_window": "allow",
    "engram_file_lock": "allow"
  },

  "mcp": {
    "engram": {
      "type": "local",
      "command": ["node", "{env:AXON_ENGRAM_MCP_SERVER}"],
      "environment": {
        "ENGRAM_API_KEY": "{env:ENGRAM_API_KEY}",
        "ENGRAM_WORKER_URL": "{env:ENGRAM_WORKER_URL}",
        "ENGRAM_AGENT_RUNTIME": "axon"
      },
      "enabled": true,
      "timeout": 10000
    },
    "agentic-mcp": {
      "type": "local",
      "command": ["node", "{env:AXON_AGENTIC_MCP_SERVER}"],
      "enabled": true,
      "timeout": 10000
    }
  }
}
