{
  "$schema": "https://opencode.ai/config.json",

  // DeepSeek V4 Pro direct API — remote variant.
  // MCP connects to localhost:8000 (no CF tunnel overhead).
  "enabled_providers": ["deepseek"],
  "model": "deepseek/{env:AXON_DEEPSEEK_MODEL}",
  "small_model": "deepseek/{env:AXON_DEEPSEEK_MODEL}",

  "provider": {
    "deepseek": {
      "name": "DeepSeek",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "timeout": 300000
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "family": "deepseek",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },

  "tools": {
    "task": false,
    "skill": false,
    "todowrite": false,
    "webfetch": false,
    "websearch": false,
    "codesearch": false
  },

  "permission": {
    "vergence-p_*": "allow"
  },

  "mcp": {
    "vergence-p": {
      "type": "remote",
      "url": "http://127.0.0.1:8000/mcp/",
      "enabled": true,
      "timeout": 600000
    }
  }
}
