#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPTS="$ROOT/scripts"

# --- Profile selection ---
PROFILE_NAME="${AXON_PROFILE:-vector-qwen-engram}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      PROFILE_NAME="$2"
      shift 2
      ;;
    --profile=*)
      PROFILE_NAME="${1#*=}"
      shift
      ;;
    *)
      break
      ;;
  esac
done

PROFILE="$ROOT/profiles/axon.${PROFILE_NAME}.jsonc"
if [[ ! -f "$PROFILE" ]]; then
  echo "Unknown profile: $PROFILE_NAME" >&2
  echo "Available: $(ls "$ROOT/profiles/"axon.*.jsonc 2>/dev/null | xargs -I{} basename {} .jsonc | sed 's/^axon\.//' | paste -sd', ')" >&2
  exit 1
fi

# --- Auto-load ENGRAM_API_KEY from engram-server .env if not set ---
if [[ -z "${ENGRAM_API_KEY:-}" && "$PROFILE_NAME" != "minimal-offline" ]]; then
  ENGRAM_ENV="$HOME/engram/engram-server/.env"
  if [[ -f "$ENGRAM_ENV" ]]; then
    ENGRAM_API_KEY="$(grep -m1 '^ENGRAM_API_KEY=' "$ENGRAM_ENV" | cut -d= -f2-)"
    export ENGRAM_API_KEY
    echo "note: loaded ENGRAM_API_KEY from $ENGRAM_ENV" >&2
  fi
fi

# --- Env defaults ---
: "${AXON_QWEN_BASE_URL:=http://192.168.1.153:8081/v1}"
: "${AXON_QWEN_MODEL_ID:=Qwen3.6-35B-A3B-abliterated-Q4_K_M.gguf}"
: "${AXON_ENGRAM_MCP_SERVER:=/home/mmca/mcp-servers/engram-mcp/engram-mcp-server.mjs}"
: "${AXON_AGENTIC_MCP_SERVER:=/home/mmca/mcp-servers/agentic-mcp/agentic-mcp-server.mjs}"
: "${ENGRAM_WORKER_URL:=http://localhost:37779}"
: "${AXON_ENGRAM_MCP_NAMES:=engram,agentic-mcp}"

export AXON_QWEN_BASE_URL AXON_QWEN_MODEL_ID ENGRAM_WORKER_URL
export AXON_ENGRAM_MCP_SERVER AXON_AGENTIC_MCP_SERVER AXON_ENGRAM_MCP_NAMES

# --- Subcommand dispatch ---
CMD="${1:-}"
shift 2>/dev/null || true

engram_status() {
  if [[ "$PROFILE_NAME" == "minimal-offline" ]]; then
    echo "offline"
  elif curl -fsS "${ENGRAM_WORKER_URL%/}/health" >/dev/null 2>&1; then
    echo "connected"
  else
    echo "unreachable"
  fi
}

model_short() {
  local m="${AXON_QWEN_MODEL_ID%.gguf}"
  m="${m##*/}"
  echo "$m"
}

banner() {
  local model engram pad
  model="$(model_short)"
  engram="$(engram_status)"

  local l1="AXON v${VERSION}"
  local l2="model: ${model}"
  local l3="engram: ${engram}"
  local l4="profile: ${PROFILE_NAME}"

  # Find longest line for box width
  local maxlen=0
  for line in "$l1" "$l2" "$l3" "$l4"; do
    (( ${#line} > maxlen )) && maxlen=${#line}
  done
  local w=$(( maxlen + 4 ))

  printf '  \033[36m┌%s┐\033[0m\n' "$(printf '─%.0s' $(seq 1 "$w"))"
  for line in "$l1" "$l2" "$l3" "$l4"; do
    pad=$(( w - ${#line} - 2 ))
    printf '  \033[36m│\033[0m  %s%*s \033[36m│\033[0m\n' "$line" "$pad" ""
  done
  printf '  \033[36m└%s┘\033[0m\n' "$(printf '─%.0s' $(seq 1 "$w"))"
}

first_run() {
  local cfg_dir="$HOME/.axon"
  local cfg_file="$cfg_dir/config.json"
  [[ -f "$cfg_file" ]] && return

  echo ""
  echo "  Welcome to Axon — a networked coding-agent harness."
  echo ""
  echo "  Axon wraps OpenCode with Engram memory, multi-agent coordination,"
  echo "  and persistent sessions. It runs local LLMs (Qwen on Vector) or"
  echo "  cloud providers (OpenRouter)."
  echo ""
  echo "  Quick start:"
  echo "    axon              Interactive TUI session"
  echo "    axon run <prompt>  Headless single-prompt mode"
  echo "    axon help          Show all commands"
  echo ""

  mkdir -p "$cfg_dir"
  cat > "$cfg_file" <<-JSON
	{
	  "version": "${VERSION}",
	  "created": "$(date -Iseconds)",
	  "profile": "${PROFILE_NAME}"
	}
	JSON
  echo "  Config created: $cfg_file"
  echo ""
}

launch() {
  if ! command -v bun >/dev/null 2>&1; then
    echo "bun is required to launch the vendored OpenCode runtime." >&2
    exit 1
  fi

  if [[ "$PROFILE_NAME" != "minimal-offline" && -z "${ENGRAM_API_KEY:-}" ]]; then
    echo "ENGRAM_API_KEY is required for profile '$PROFILE_NAME'." >&2
    exit 1
  fi

  [[ -n "${ENGRAM_API_KEY:-}" ]] && export ENGRAM_API_KEY
  [[ -n "${OPENROUTER_API_KEY:-}" ]] && export OPENROUTER_API_KEY
  export OPENCODE_CONFIG_CONTENT="$(cat "$PROFILE")"

  cd "$ROOT/opencode"
  exec bun run dev "$@"
}

case "$CMD" in
  ""|tui)
    first_run
    banner
    launch "$@"
    ;;
  run)
    if [[ $# -eq 0 ]]; then
      echo "Usage: axon run <prompt>" >&2
      exit 1
    fi
    banner
    launch run --pure --dangerously-skip-permissions "$@"
    ;;
  version|-v|--version)
    echo "axon v${VERSION}"
    echo "model: $(model_short)"
    echo "engram: $(engram_status)"
    echo "profile: ${PROFILE_NAME}"
    ;;
  smoke)
    if [[ "${1:-}" == "--cloud" ]]; then
      shift
      exec bash "$SCRIPTS/smoke-cloud-openrouter.sh" "$@"
    fi
    exec bash "$SCRIPTS/smoke-vector-qwen.sh" "$@"
    ;;
  test)
    exec bash "$SCRIPTS/test-interop.sh" "$@"
    ;;
  inbox)
    exec bash "$SCRIPTS/axon-inbox.sh" "$@"
    ;;
  tasks)
    exec bash "$SCRIPTS/axon-tasks.sh" "$@"
    ;;
  status)
    exec bash "$SCRIPTS/axon-status.sh" "$@"
    ;;
  fleet)
    exec bash "$SCRIPTS/start-axon-fleet.sh" "$@"
    ;;
  help|-h|--help)
    cat <<HELP
axon v${VERSION} — networked coding-agent harness

Usage: axon [--profile NAME] [command] [args...]

Commands:
  (default)      Interactive TUI session
  run <prompt>   Headless single-prompt mode
  version        Show version, model, and engram status
  inbox          Check Engram inbox for unread messages
  tasks          Show active tasks assigned to this agent
  smoke          Run smoke test suite (--cloud for OpenRouter)
  test           Run interop test suite
  status         Show Axon agent/service status
  fleet <N>      Start N agents in tmux sessions
  help           Show this help

Options:
  --profile NAME   Select deployment profile (default: vector-qwen-engram)
                   Available: vector-qwen-engram, remote-engram, cloud-openrouter, minimal-offline

Environment:
  AXON_PROFILE         Default profile name
  ENGRAM_API_KEY       Engram authentication (auto-loaded from ~/engram/engram-server/.env)
  AXON_QWEN_BASE_URL   Qwen endpoint (default: http://192.168.1.153:8081/v1)
  OPENROUTER_API_KEY   Required for cloud-openrouter profile
HELP
    ;;
  *)
    echo "Unknown command: $CMD (try 'axon help')" >&2
    exit 1
    ;;
esac
