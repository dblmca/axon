#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPTS="$ROOT/scripts"

# --- Load env file (API keys, like ~/.codex/api_key.env) ---
AXON_ENV="${AXON_ENV:-$HOME/.axon/env}"
if [[ -f "$AXON_ENV" ]]; then
  set -a
  source "$AXON_ENV"
  set +a
fi

# --- Profile selection ---
PROFILE_NAME="${AXON_PROFILE:-vector-qwen-engram}"
PROFILE_SPECIFIED=false
MODEL_OVERRIDE=""
PROJECT_OVERRIDE=""
TASK_ID=""
USE_WORKTREE=false
SKIP_PERMISSIONS=false
AXON_PROJECT_DIR="$PWD"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      PROFILE_SPECIFIED=true
      PROFILE_NAME="$2"
      shift 2
      ;;
    --profile=*)
      PROFILE_SPECIFIED=true
      PROFILE_NAME="${1#*=}"
      shift
      ;;
    --model)
      MODEL_OVERRIDE="$2"
      shift 2
      ;;
    --model=*)
      MODEL_OVERRIDE="${1#*=}"
      shift
      ;;
    --project)
      PROJECT_OVERRIDE="$2"
      shift 2
      ;;
    --project=*)
      PROJECT_OVERRIDE="${1#*=}"
      shift
      ;;
    --task)
      TASK_ID="$2"
      shift 2
      ;;
    --task=*)
      TASK_ID="${1#*=}"
      shift
      ;;
    --worktree)
      USE_WORKTREE=true
      shift
      ;;
    --yes|--skip-permissions|--dangerously-skip-permissions)
      SKIP_PERMISSIONS=true
      shift
      ;;
    *)
      break
      ;;
  esac
done

PROFILE="$ROOT/profiles/axon.${PROFILE_NAME}.jsonc"
if [[ ! -f "$PROFILE" ]]; then
  echo "Unknown profile: $PROFILE_NAME" >&2
  echo "Available: $(ls "$ROOT/profiles/"axon.*.jsonc 2>/dev/null | xargs -I{} basename {} .jsonc | sed 's/^axon\.//' | paste -sd', ')" >&2
  exit 1
fi

# --- Auto-load ENGRAM_API_KEY from engram-server .env if not set ---
if [[ -z "${ENGRAM_API_KEY:-}" && "$PROFILE_NAME" != "minimal-offline" ]]; then
  ENGRAM_ENV="$HOME/engram/engram-server/.env"
  if [[ -f "$ENGRAM_ENV" ]]; then
    ENGRAM_API_KEY="$(grep -m1 '^ENGRAM_API_KEY=' "$ENGRAM_ENV" | cut -d= -f2-)"
    export ENGRAM_API_KEY
    echo "note: loaded ENGRAM_API_KEY from $ENGRAM_ENV" >&2
  fi
fi

# --- Env defaults ---
: "${AXON_QWEN_BASE_URL:=http://192.168.1.153:8081/v1}"
: "${AXON_QWEN_MODEL_ID:=Qwen3.6-35B-A3B-abliterated-Q4_K_M.gguf}"
: "${AXON_OPENROUTER_MODEL:=deepseek/deepseek-v4-pro}"
: "${AXON_DEEPSEEK_MODEL:=deepseek-v4-pro}"
: "${AXON_ENGRAM_MCP_SERVER:=/home/mmca/mcp-servers/engram-mcp/engram-mcp-server.mjs}"
: "${AXON_AGENTIC_MCP_SERVER:=/home/mmca/mcp-servers/agentic-mcp/agentic-mcp-server.mjs}"
: "${ENGRAM_WORKER_URL:=http://localhost:37779}"
: "${AXON_ENGRAM_MCP_NAMES:=engram,agentic-mcp}"

if [[ -n "$MODEL_OVERRIDE" ]]; then
  case "$PROFILE_NAME" in
    cloud-openrouter)
      export AXON_OPENROUTER_MODEL="$MODEL_OVERRIDE"
      ;;
    cloud-deepseek)
      export AXON_DEEPSEEK_MODEL="$MODEL_OVERRIDE"
      ;;
    *)
      export AXON_QWEN_MODEL_ID="$MODEL_OVERRIDE"
      ;;
  esac
fi

if [[ -n "$PROJECT_OVERRIDE" ]]; then
  export ENGRAM_PROJECT="$PROJECT_OVERRIDE"
fi

export AXON_QWEN_BASE_URL AXON_QWEN_MODEL_ID ENGRAM_WORKER_URL
export AXON_ENGRAM_MCP_SERVER AXON_AGENTIC_MCP_SERVER AXON_ENGRAM_MCP_NAMES
[[ -n "${AXON_OPENROUTER_MODEL:-}" ]] && export AXON_OPENROUTER_MODEL
[[ -n "${AXON_DEEPSEEK_MODEL:-}" ]] && export AXON_DEEPSEEK_MODEL
[[ -n "${ENGRAM_PROJECT:-}" ]] && export ENGRAM_PROJECT

# --- Subcommand dispatch ---
CMD="${1:-}"
shift 2>/dev/null || true

engram_status() {
  if [[ "$PROFILE_NAME" == "minimal-offline" ]]; then
    echo "offline"
  elif curl -fsS "${ENGRAM_WORKER_URL%/}/health" >/dev/null 2>&1; then
    echo "connected"
  else
    echo "unreachable"
  fi
}

model_short() {
  local m
  if [[ "$PROFILE_NAME" == "cloud-openrouter" ]]; then
    m="${AXON_OPENROUTER_MODEL:-unset}"
  elif [[ "$PROFILE_NAME" == "cloud-deepseek" ]]; then
    m="${AXON_DEEPSEEK_MODEL:-unset}"
  else
    m="${AXON_QWEN_MODEL_ID%.gguf}"
  fi
  m="${m##*/}"
  echo "$m"
}

skip_permissions_enabled() {
  case "${AXON_SKIP_PERMISSIONS:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
  esac
  [[ "$SKIP_PERMISSIONS" == true ]]
}

banner() {
  local model engram pad
  model="$(model_short)"
  engram="$(engram_status)"

  local l1="AXON v${VERSION}"
  local l2="model: ${model}"
  local l3="engram: ${engram}"
  local l4="profile: ${PROFILE_NAME}"

  # Find longest line for box width
  local maxlen=0
  for line in "$l1" "$l2" "$l3" "$l4"; do
    (( ${#line} > maxlen )) && maxlen=${#line}
  done
  local w=$(( maxlen + 4 ))

  printf '  \033[36m┌%s┐\033[0m\n' "$(printf '─%.0s' $(seq 1 "$w"))"
  for line in "$l1" "$l2" "$l3" "$l4"; do
    pad=$(( w - ${#line} - 2 ))
    printf '  \033[36m│\033[0m  %s%*s \033[36m│\033[0m\n' "$line" "$pad" ""
  done
  printf '  \033[36m└%s┘\033[0m\n' "$(printf '─%.0s' $(seq 1 "$w"))"
}

first_run() {
  local cfg_dir="$HOME/.axon"
  local cfg_file="$cfg_dir/config.json"
  [[ -f "$cfg_file" ]] && return

  echo ""
  echo "  Welcome to Axon — a networked coding-agent harness."
  echo ""
  echo "  Axon wraps OpenCode with Engram memory, multi-agent coordination,"
  echo "  and persistent sessions. It runs local LLMs (Qwen on Vector) or"
  echo "  cloud providers (OpenRouter)."
  echo ""
  echo "  Quick start:"
  echo "    axon              Interactive TUI session"
  echo "    axon run <prompt>  Headless single-prompt mode"
  echo "    axon help          Show all commands"
  echo ""

  mkdir -p "$cfg_dir"
  cat > "$cfg_file" <<-JSON
	{
	  "version": "${VERSION}",
	  "created": "$(date -Iseconds)",
	  "profile": "${PROFILE_NAME}"
	}
	JSON
  echo "  Config created: $cfg_file"
  echo ""
}

launch() {
  [[ -n "${ENGRAM_API_KEY:-}" ]] && export ENGRAM_API_KEY
  [[ -n "${OPENROUTER_API_KEY:-}" ]] && export OPENROUTER_API_KEY
  [[ -n "${DEEPSEEK_API_KEY:-}" ]] && export DEEPSEEK_API_KEY
  export AXON_PROJECT_DIR
  export OPENCODE_CONFIG_CONTENT="$(cat "$PROFILE")"

  if [[ "${AXON_DRY_RUN:-}" == "1" || "${AXON_DRY_RUN:-}" == "fail" ]]; then
    echo "profile: ${PROFILE_NAME}"
    echo "project_dir: ${AXON_PROJECT_DIR}"
    [[ -n "${ENGRAM_PROJECT:-}" ]] && echo "project: ${ENGRAM_PROJECT}"
    if [[ "$PROFILE_NAME" == "cloud-openrouter" ]]; then
      echo "model: ${AXON_OPENROUTER_MODEL:-}"
    elif [[ "$PROFILE_NAME" == "cloud-deepseek" ]]; then
      echo "model: ${AXON_DEEPSEEK_MODEL:-}"
    else
      echo "model: ${AXON_QWEN_MODEL_ID}"
    fi
    printf 'command: bun run dev'
    printf ' %q' "$@"
    printf '\n'
    [[ "${AXON_DRY_RUN:-}" == "fail" ]] && return 1
    return 0
  fi

  if ! command -v bun >/dev/null 2>&1; then
    echo "bun is required to launch the vendored OpenCode runtime." >&2
    exit 1
  fi

  if [[ "$PROFILE_NAME" != "minimal-offline" && -z "${ENGRAM_API_KEY:-}" ]]; then
    echo "ENGRAM_API_KEY is required for profile '$PROFILE_NAME'." >&2
    exit 1
  fi

  cd "$ROOT/opencode"
  bun run dev "$@"
}

cleanup_worktree() {
  local exit_code=$?
  if [[ -n "${WORKTREE_PATH:-}" && -d "$WORKTREE_PATH" ]]; then
    if [[ $exit_code -eq 0 ]] && [[ -z "$(git -C "$WORKTREE_PATH" status --porcelain 2>/dev/null)" ]]; then
      git worktree remove "$WORKTREE_PATH" >/dev/null 2>&1 || true
    else
      echo "Worktree kept (dirty or failed): $WORKTREE_PATH" >&2
    fi
  fi
}

setup_worktree() {
  if [[ "$USE_WORKTREE" != true ]]; then
    return
  fi
  if [[ -z "$TASK_ID" ]]; then
    echo "--worktree requires --task <id>" >&2
    exit 1
  fi

  local safe_task
  safe_task="$(printf '%s' "$TASK_ID" | tr -c 'A-Za-z0-9_.-' '-')"
  WORKTREE_ROOT="${AXON_WORKTREE_ROOT:-/tmp/axon-worktrees}"
  WORKTREE_PATH="$WORKTREE_ROOT/task-${safe_task}"
  mkdir -p "$WORKTREE_ROOT"
  git -C "$ROOT" worktree add "$WORKTREE_PATH" HEAD >/dev/null 2>&1 || {
    echo "Failed to create worktree for task $TASK_ID at $WORKTREE_PATH" >&2
    exit 1
  }
  cd "$WORKTREE_PATH"
  AXON_PROJECT_DIR="$WORKTREE_PATH"
  export AXON_TASK_ID="$TASK_ID"
  export AXON_WORKTREE="$WORKTREE_PATH"
  trap cleanup_worktree EXIT
}

case "$CMD" in
  ""|tui)
    first_run
    banner
    launch "$@"
    ;;
  run)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --yes|--skip-permissions|--dangerously-skip-permissions)
          SKIP_PERMISSIONS=true
          shift
          ;;
        --)
          shift
          break
          ;;
        *)
          break
          ;;
      esac
    done

    if [[ $# -eq 0 ]]; then
      echo "Usage: axon run <prompt>" >&2
      exit 1
    fi
    setup_worktree
    banner
    # Init engram session before OpenCode run (plugin may not fire in headless mode)
    AXON_SESSION_ID="ses_$(date +%s%N | head -c13)$(head -c6 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c10)"
    AXON_PROJECT="${ENGRAM_PROJECT:-$(basename "$AXON_PROJECT_DIR")}"
    export AXON_SESSION_ID AXON_PROJECT
    # Ensure axon-engram plugin is discoverable in the target project dir
    AXON_PLUGIN_SRC="$ROOT/opencode/.opencode/plugin"
    AXON_PLUGIN_DST="$AXON_PROJECT_DIR/.opencode/plugin"
    AXON_PLUGIN_CLEANUP=""
    if [[ -d "$AXON_PLUGIN_SRC" && ! -e "$AXON_PLUGIN_DST" ]]; then
      mkdir -p "$AXON_PROJECT_DIR/.opencode"
      ln -sfn "$AXON_PLUGIN_SRC" "$AXON_PLUGIN_DST"
      AXON_PLUGIN_CLEANUP="$AXON_PLUGIN_DST"
    fi
    if [[ -n "${ENGRAM_API_KEY:-}" && -n "${ENGRAM_WORKER_URL:-}" ]]; then
      curl -sf "${ENGRAM_WORKER_URL}/api/sessions/init" \
        -H "x-api-key: ${ENGRAM_API_KEY}" -H "Content-Type: application/json" \
        -d "{\"sdk_session_id\":\"${AXON_SESSION_ID}\",\"project\":\"${AXON_PROJECT}\",\"source_ai\":\"axon\",\"client_hostname\":\"$(hostname)\"}" \
        >/dev/null 2>&1 || true
    fi
    run_args=(run --dir "$AXON_PROJECT_DIR")
    if skip_permissions_enabled; then
      run_args+=(--dangerously-skip-permissions)
    fi
    launch "${run_args[@]}" "$@"
    RUN_EXIT=$?
    # Cleanup symlink + complete engram session
    [[ -n "$AXON_PLUGIN_CLEANUP" ]] && rm -f "$AXON_PLUGIN_CLEANUP"
    if [[ -n "${ENGRAM_API_KEY:-}" && -n "${ENGRAM_WORKER_URL:-}" ]]; then
      curl -sf "${ENGRAM_WORKER_URL}/api/sessions/${AXON_SESSION_ID}/complete" \
        -X POST -H "x-api-key: ${ENGRAM_API_KEY}" -H "Content-Type: application/json" \
        -d '{}' >/dev/null 2>&1 || true
    fi
    exit $RUN_EXIT
    ;;
  version|-v|--version)
    echo "axon v${VERSION}"
    echo "model: $(model_short)"
    echo "engram: $(engram_status)"
    echo "profile: ${PROFILE_NAME}"
    ;;
  smoke)
    if [[ "${1:-}" == "--cloud" ]]; then
      shift
      exec bash "$SCRIPTS/smoke-cloud-openrouter.sh" "$@"
    fi
    exec bash "$SCRIPTS/smoke-vector-qwen.sh" "$@"
    ;;
  test)
    exec bash "$SCRIPTS/test-interop.sh" "$@"
    ;;
  inbox)
    exec bash "$SCRIPTS/axon-inbox.sh" "$@"
    ;;
  tasks)
    exec bash "$SCRIPTS/axon-tasks.sh" "$@"
    ;;
  status)
    exec bash "$SCRIPTS/axon-status.sh" "$@"
    ;;
  fleet)
    fleet_args=()
    [[ "$PROFILE_SPECIFIED" == true ]] && fleet_args+=(--profile "$PROFILE_NAME")
    [[ -n "$MODEL_OVERRIDE" ]] && fleet_args+=(--model "$MODEL_OVERRIDE")
    [[ -n "$PROJECT_OVERRIDE" ]] && fleet_args+=(--project "$PROJECT_OVERRIDE")
    exec bash "$SCRIPTS/start-axon-fleet.sh" "${fleet_args[@]}" "$@"
    ;;
  help|-h|--help)
    cat <<HELP
axon v${VERSION} — networked coding-agent harness

Usage: axon [--profile NAME] [command] [args...]

Commands:
  (default)      Interactive TUI session
  run <prompt>   Headless single-prompt mode
  version        Show version, model, and engram status
  inbox          Check Engram inbox for unread messages
  tasks          Show active tasks assigned to this agent
  smoke          Run smoke test suite (--cloud for OpenRouter)
  test           Run interop test suite
  status         Show Axon agent/service status
  fleet <N>      Start N agents in tmux sessions
  help           Show this help

Options:
  --profile NAME    Select deployment profile (default: vector-qwen-engram)
                    Available: vector-qwen-engram, remote-engram, cloud-openrouter, cloud-deepseek, minimal-offline
  --model SLUG      Override the selected profile model
  --project NAME    Override Engram project registration
  --task ID         Set task id for a run
  --worktree        Run a task in /tmp/axon-worktrees/task-ID
  --yes             Auto-approve headless run permissions

Environment:
  AXON_PROFILE         Default profile name
  AXON_WORKTREE_ROOT   Worktree root (default: /tmp/axon-worktrees)
  ENGRAM_API_KEY       Engram authentication (auto-loaded from ~/engram/engram-server/.env)
  AXON_QWEN_BASE_URL   Qwen endpoint (default: http://192.168.1.153:8081/v1)
  AXON_QWEN_MODEL_ID   Local Qwen model id
  AXON_OPENROUTER_MODEL OpenRouter model id
  OPENROUTER_API_KEY   Required for cloud-openrouter profile
  AXON_SKIP_PERMISSIONS Set to 1 to auto-approve headless run permissions
HELP
    ;;
  *)
    echo "Unknown command: $CMD (try 'axon help')" >&2
    exit 1
    ;;
esac
